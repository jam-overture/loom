{
  "name": "@loom/portal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @loom/runtime build && next build",
    "start": "next start",
    "typecheck": "pnpm --filter @loom/runtime build && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "db:push": "tsx scripts/db-push.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@loom/runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@next/env": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}

# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Identity (0027) — required. Without the secret below, nobody can sign in.
#
# This is deliberate: absence fails closed. A portal that quietly degraded to
# open access would look exactly like one that is working correctly.
# ---------------------------------------------------------------------------

# Signs session cookies. At least 32 characters.
#   openssl rand -hex 32
# Rotating it signs everyone out; it is the only way to invalidate a session.
LOOM_PORTAL_SESSION_SECRET=

# Who may sign in is NOT a variable. It was LOOM_PORTAL_REVIEWERS until 0285,
# and it is a table now, because the workspace lists the projects YOU hold a
# role in and a string in a deployment's configuration cannot own a row.
#
# There is nothing to set here. There is a command:
#
#   pnpm db:push                            # once, so the tables exist
#   pnpm portal:account ana@example.com     # prints a key, once
#
# The key IS the identity — somebody presents a key and the accounts table says
# who that is, so there is no name to type and nothing to forge. It is stored as
# a digest, so it cannot be read back: run the command again for the same actor
# to replace it, which ends the old one.
#
# The actor is what lands in Provenance.actor, so use something a reader will
# recognise. Add a role when you know the project:
#
#   pnpm portal:account ana@example.com prj_a1b2c3 owner
#
# This is also the one thing that needs a database before anybody can sign in.

# Email and password (0310). Set all three, or the sign-in page offers keys
# alone. Supabase Auth holds the passwords and sends the confirmation and reset
# emails; the session is still ours. In Supabase, set the Site URL and add
# https://<your domain>/** to the Redirect URLs, or those links land elsewhere.
# Server-side only: never prefix them NEXT_PUBLIC_.
LOOM_SUPABASE_URL=
LOOM_SUPABASE_ANON_KEY=

# Who may have an account, comma-separated. Unset is nobody, not everybody.
LOOM_PORTAL_EMAILS=

# ---------------------------------------------------------------------------
# Optional — absence degrades honestly here, unlike identity above.
# ---------------------------------------------------------------------------

# Where this deployment answers from, with no trailing slash — the production
# domain, pinned. Every canonical URL, the sitemap, the OG tags and every
# internal link in the page tree is built from it, because a tree may only hold
# absolute hrefs (0053) and the origin is therefore resolved per request.
# Unset means VERCEL_URL, which is a different host on every preview — correct
# for a preview, wrong for the site people are meant to find.
LOOM_SITE_ORIGIN=

# The model that interprets an utterance into a delta. Unset means the prompt
# box says so and the read path still works. Falls back to ANTHROPIC_API_KEY.
# Never prefix it NEXT_PUBLIC_.
LOOM_ANTHROPIC_API_KEY=

# Supabase transaction pooler, port 6543 — not 5432. The bare URL: a value that
# reads DATABASE_URL=postgresql://… has the key name inside the value.
# Unset means the store is in memory, which a serverless deployment forgets.
# It also backs the sign-in throttle (0034), which counts per instance without it.
DATABASE_URL=

# Whether this deployment keeps the reader signals its pages broadcast. Unset
# means /api/reader-signals answers 404 to every delivery, which is the point:
# signals are off unless a host asks (0136), and a deployment that never asked
# should not have loom_reader_signals filling up. Set it to "on" to collect.
# A value that is neither on nor off is refused rather than read as off.
LOOM_SIGNAL_INTAKE=

# Which project the marketing site's readers are counted under, by its prj_ id.
# Unset means the deployment's own project, which nobody is a member of; name a
# project you registered to watch the site's readers on its Signals screen. Its
# host must be blank or this site's own, or it refuses the site's deliveries.
LOOM_SITE_PROJECT=

# How many proxies sit in front of this app. The sign-in throttle and the
# reader-signal endpoint both count a caller by the forwarded-for entry that
# many hops from the right, because the entries to the left are ones the caller
# could have written themselves. One deployment, one number.
# Unset means 1, which is correct on Vercel. Raise it only if you have put
# something else in front — a CDN or a WAF makes it 2.
LOOM_PORTAL_TRUSTED_PROXY_HOPS=

# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Identity (0027) — required. Without the secret below, nobody can sign in.
#
# This is deliberate: absence fails closed. A portal that quietly degraded to
# open access would look exactly like one that is working correctly.
# ---------------------------------------------------------------------------

# Signs session cookies. At least 32 characters.
#   openssl rand -hex 32
# Rotating it signs everyone out; it is the only way to invalidate a session.
LOOM_PORTAL_SESSION_SECRET=

# Who may sign in is NOT a variable. It was LOOM_PORTAL_REVIEWERS until 0285,
# and it is a table now, because the workspace lists the projects YOU hold a
# role in and a string in a deployment's configuration cannot own a row.
#
# There is nothing to set here. There is a command:
#
#   pnpm db:push                            # once, so the tables exist
#   pnpm portal:account ana@example.com     # prints a key, once
#
# The key IS the identity — somebody presents a key and the accounts table says
# who that is, so there is no name to type and nothing to forge. It is stored as
# a digest, so it cannot be read back: run the command again for the same actor
# to replace it, which ends the old one.
#
# The actor is what lands in Provenance.actor, so use something a reader will
# recognise. Add a role when you know the project:
#
#   pnpm portal:account ana@example.com prj_a1b2c3 owner
#
# This is also the one thing that needs a database before anybody can sign in.

# Email and password (0310). Set all three, or the sign-in page offers keys
# alone. Supabase Auth holds the passwords and sends the confirmation and reset
# emails; the session is still ours. In Supabase, set the Site URL and add
# https://<your domain>/** to the Redirect URLs, or those links land elsewhere.
# Server-side only: never prefix them NEXT_PUBLIC_.
LOOM_SUPABASE_URL=
LOOM_SUPABASE_ANON_KEY=

# Who may have an account, comma-separated. Unset is nobody, not everybody.
LOOM_PORTAL_EMAILS=

# ---------------------------------------------------------------------------
# Optional — absence degrades honestly here, unlike identity above.
# ---------------------------------------------------------------------------

# Where this deployment answers from, with no trailing slash — the production
# domain, pinned. Every canonical URL, the sitemap, the OG tags and every
# internal link in the page tree is built from it, because a tree may only hold
# absolute hrefs (0053) and the origin is therefore resolved per request.
# Unset means VERCEL_URL, which is a different host on every preview — correct
# for a preview, wrong for the site people are meant to find.
LOOM_SITE_ORIGIN=

# The model the demo and the docs interpret with. Unset means their prompt box
# says so and the read path still works. Falls back to ANTHROPIC_API_KEY.
# A portal project never uses it: each pays with its own key, set by an owner
# on the project's Settings (0332). Never prefix it NEXT_PUBLIC_.
LOOM_ANTHROPIC_API_KEY=

# Lets Vercel's daily schedule (vercel.json) start Loom's proposals at
# /api/proposals (0329). 16 characters or more. Unset means the route refuses,
# so nobody can spend the projects' keys by calling it.
#   openssl rand -hex 32
CRON_SECRET=

# Supabase transaction pooler, port 6543 — not 5432. The bare URL: a value that
# reads DATABASE_URL=postgresql://… has the key name inside the value.
# Unset means the store is in memory, which a serverless deployment forgets.
# It also backs the sign-in throttle (0034), which counts per instance without it.
DATABASE_URL=

# Whether this deployment keeps the reader signals its pages broadcast. Unset
# means /api/reader-signals answers 404 to every delivery, which is the point:
# signals are off unless a host asks (0136), and a deployment that never asked
# should not have loom_reader_signals filling up. Set it to "on" to collect.
# A value that is neither on nor off is refused rather than read as off.
LOOM_SIGNAL_INTAKE=

# Which project the marketing site's readers are counted under, by its prj_ id.
# Unset means the deployment's own project, which nobody is a member of; name a
# project you registered to watch the site's readers on its Signals screen. Its
# host must be blank or this site's own, or it refuses the site's deliveries.
LOOM_SITE_PROJECT=

# The project's publish key (lp_…), made by an owner on its Connect your site
# screen and shown once. With it, every production build ends by sending the
# site's pages to the deployment at LOOM_SITE_ORIGIN (0312, 0369), so the
# portal and the live pages start from the code that is going out. Unset, or on
# a preview, the build says so in one line and publishes nothing; a refusal
# never fails the build. It is a secret: it changes what Loom believes a page is.
LOOM_PUBLISH_KEY=

# How many proxies sit in front of this app. The sign-in throttle and the
# reader-signal endpoint both count a caller by the forwarded-for entry that
# many hops from the right, because the entries to the left are ones the caller
# could have written themselves. One deployment, one number.
# Unset means 1, which is correct on Vercel. Raise it only if you have put
# something else in front — a CDN or a WAF makes it 2.
LOOM_PORTAL_TRUSTED_PROXY_HOPS=

# How old a delivery gets before the sweep counts it into the totals, in whole
# milliseconds. Unset means 3600000 — one hour — and anything under 60000 is
# refused. Longer is more accurate and shorter is more anonymous: it is also
# how long a page view has to finish and how long a view key lives, so step 9
# of docs/deployment.md has the three things one number decides. A value that
# cannot be read stops the sweep rather than being replaced by the default.
LOOM_SIGNAL_WINDOW_MS=

# How long a counted delivery is kept before it is deleted, in whole
# milliseconds. Unset means 2592000000 — thirty days — and anything under 60000
# is refused. This is the one of the two windows your readers are promised: the
# signals behind a page view stay correlatable for as long as it lasts, which
# is what makes the portal's Events tab possible. A value that cannot be read
# deletes nothing while the notice still publishes the default, so it is
# reported on GET /api/reader-signals rather than quietly corrected.
LOOM_SIGNAL_KEPT_MS=

# How often you actually run signals:collect, in whole milliseconds. Nothing in
# this application can discover it — a cron, a deploy hook or a person runs the
# sweep — and nothing is refused or changed if it is unset. What it buys is one
# sentence for your readers: stated, the notice publishes a ceiling on how long
# a delivery lives (this plus the window above) instead of only the age at
# which one ripens. Set it to the interval of the cron in step 9.
LOOM_SIGNAL_SWEEP_MS=

# Whether this deployment counts which country its readers are in. On by
# default, which is the one default here that is not off: switching intake on
# is already the opt-in, and a floored count of page views per country, with
# the address it was read from never stored, is the least a measurement can say
# about anybody. Set it to "off" if you have your own reason to refuse.
LOOM_SIGNAL_REGION=

# The header a reader's country is read from. Unset means x-vercel-ip-country,
# which this platform writes and overwrites, so a caller cannot choose their
# own. Name your own header if you deploy behind something else — and if what
# is in front passes a caller's value through, switch regions off above rather
# than count buckets a stranger can fill.
LOOM_SIGNAL_REGION_HEADER=

# The smallest bucket a region count will name. Unset means 25 and the runtime
# will only go up: a floor is what makes an aggregate an aggregate, so you may
# be more careful than the default and not less. A number that was refused is
# said out loud on GET /api/reader-signals rather than silently replaced.
LOOM_SIGNAL_REGION_FLOOR=

# How old a telemetry row gets before telemetry:prune deletes it, in whole
# milliseconds. Unset means 7776000000 — ninety days. Nothing runs the prune
# for you; step 7 of docs/deployment.md is the schedule.
LOOM_TELEMETRY_MAX_AGE_MS=

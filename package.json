{
  "name": "@loom/runtime",
  "version": "0.0.1",
  "description": "Loom — an AI-powered adaptive UI runtime",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./anthropic": "./src/interpretation/anthropic.ts",
    "./react": "./src/render/index.ts",
    "./sdk": "./src/sdk/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.31.0"
}

{
  "name": "@loom/runtime",
  "version": "0.0.1",
  "description": "Loom \u2014 an AI-powered adaptive UI runtime",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/interpretation/anthropic.d.ts",
      "default": "./dist/interpretation/anthropic.js"
    },
    "./react": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./write": {
      "types": "./dist/write/index.d.ts",
      "default": "./dist/write/index.js"
    },
    "./postgres": {
      "types": "./dist/store/postgres.d.ts",
      "default": "./dist/store/postgres.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./telemetry/postgres": {
      "types": "./dist/telemetry/postgres.d.ts",
      "default": "./dist/telemetry/postgres.js"
    }
  },
  "bin": {
    "loom": "./dist/cli/main.js"
  },
  "scripts": {
    "loom": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm --filter @loom/portal verify",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "decisions:index": "tsx tools/decisions/build-index.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "react": "^19.0.0",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "drizzle-orm": "^0.45.2"
  },
  "packageManager": "pnpm@10.31.0",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}

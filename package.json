{
  "name": "@loom/runtime",
  "version": "0.1.0",
  "description": "Loom — an AI-powered adaptive UI runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/interpretation/anthropic.d.ts",
      "default": "./dist/interpretation/anthropic.js"
    },
    "./react": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./write": {
      "types": "./dist/write/index.d.ts",
      "default": "./dist/write/index.js"
    },
    "./postgres": {
      "types": "./dist/store/postgres.d.ts",
      "default": "./dist/store/postgres.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "default": "./dist/signals/index.js"
    },
    "./signals/broadcast": {
      "types": "./dist/signals/broadcast.d.ts",
      "default": "./dist/signals/broadcast.js"
    },
    "./signals/postgres": {
      "types": "./dist/signals/postgres.d.ts",
      "default": "./dist/signals/postgres.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./telemetry/postgres": {
      "types": "./dist/telemetry/postgres.d.ts",
      "default": "./dist/telemetry/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/contracts": {
      "types": "./dist/testing/contracts.d.ts",
      "default": "./dist/testing/contracts.js"
    }
  },
  "bin": {
    "loom": "./dist/cli/main.js"
  },
  "scripts": {
    "loom": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config merge.ours.driver true || true",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm findings:check && pnpm --filter @loom/app verify && pnpm prerender:check",
    "findings:check": "tsx tools/findings/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist apps/loom/.next",
    "decisions:index": "tsx tools/decisions/build-index.ts",
    "prerender:check": "tsx tools/prerender/main.ts",
    "queue": "tsx tools/queue/main.ts",
    "package:primitives": "tsx tools/package/main.ts",
    "shoot": "tsx tools/screenshot/shoot.ts",
    "specimen": "tsx tools/specimen/main.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "vitest": "^3.0.5"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.31.0",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jam-overture/loom.git"
  },
  "keywords": [
    "loom",
    "ai",
    "adaptive-ui",
    "react",
    "server-components",
    "runtime"
  ]
}

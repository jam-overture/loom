node_modules/
dist/
coverage/
.DS_Store
*.tsbuildinfo
.claude/settings.local.json

# Never commit credentials. The interpreter reads ANTHROPIC_API_KEY from the
# environment; in the cloud routine it comes from the environment config.
.env
.env.*
!.env.example

# Next.js build output (apps/portal)
.next/
next-env.d.ts

# The publishable package is assembled by `pnpm package:primitives` from a
# build of the runtime. Its README is source and is committed; everything else
# under it is generated, and a generated file in git is a file that goes stale
# without anybody editing it.
packages/*/dist/
packages/*/package.json
packages/*/LICENSE
packages/*/*.tgz


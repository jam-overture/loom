{
  "baseUrl": "http://localhost:3000",
  "outDir": "reports",
  "shots": [
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-panel-wide",
      "viewport": "wide",
      "waitFor": "#ask",
      "do": [
        { "click": "#ask ul li:nth-child(1) form button" },
        { "waitFor": "aside li[id]" },
        { "scrollTo": "#ask" }
      ],
      "measure": [
        "#ask",
        "#ask ul li",
        "text=Puts the page back to how it looked before your last change.",
        "text=Every colour and typeface on the page changes at once."
      ]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-ending-wide",
      "viewport": "wide",
      "waitFor": "#ask",
      "do": [
        { "click": "#ask ul li:nth-child(1) form button" },
        { "waitFor": "aside li[id]" }
      ],
      "measure": [
        "aside",
        "aside li[id]",
        "section[aria-label='What you just saw']",
        "text=4 more changes to ask for"
      ]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-panel-phone",
      "viewport": "phone",
      "waitFor": "#ask",
      "do": [
        { "click": "#ask ul li:nth-child(1) form button" },
        { "waitFor": "aside li[id]" },
        { "scrollTo": "#ask" }
      ],
      "measure": [
        "#ask ul li",
        "text=Puts the page back to how it looked before your last change."
      ]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-arrival-wide-unchanged",
      "viewport": "wide",
      "waitFor": "#ask",
      "measure": ["aside", "#ask", "#ask ul li", "aside footer"]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-arrival-phone-unchanged",
      "viewport": "phone",
      "waitFor": "#ask",
      "measure": ["aside", "#ask ul li"]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-held-unchanged",
      "viewport": "wide",
      "waitFor": "#ask",
      "do": [{ "click": "#ask form button.bg-affirm" }, { "waitFor": "li button.bg-refuse" }],
      "measure": ["aside", "aside li[id]"]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-applied-unchanged",
      "viewport": "wide",
      "waitFor": "#ask",
      "do": [
        { "click": "#ask form button.bg-affirm" },
        { "waitFor": "li button.bg-refuse" },
        { "click": "li form button.bg-affirm" },
        { "waitFor": "li button.bg-neutral" }
      ],
      "measure": ["aside", "aside li[id]", "section[aria-label='What you just saw']", "text=4 more changes to ask for"]
    },
    {
      "path": "/demo",
      "out": "2026-10-07-demo-way-back-embed-unchanged",
      "viewport": { "width": 348, "height": 465, "label": "embed" },
      "waitFor": "#ask"
    }
  ]
}

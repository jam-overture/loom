{
  "baseUrl": "http://127.0.0.1:3000",
  "outDir": "reports",
  "shots": [
    {
      "path": "/docs/building-with-loom/theming",
      "out": "2026-10-15-docs-what-is-in-the-page-wide",
      "viewport": "wide",
      "waitFor": "nav[aria-label='On this page']",
      "measure": [
        "nav[aria-label='On this page']",
        "nav[aria-label='On this page'] a",
        "article.prose"
      ]
    },
    {
      "path": "/docs/building-with-loom/theming",
      "out": "2026-10-15-docs-what-is-in-the-page-marked",
      "viewport": "wide",
      "waitFor": "nav[aria-label='On this page']",
      "do": [{ "scrollTo": "h2#the-bar-above-your-page" }, { "wait": 600 }],
      "measure": [
        "nav[aria-label='On this page'] [aria-current='location']",
        "h2#the-bar-above-your-page"
      ]
    },
    {
      "path": "/docs/architecture/what-it-costs-you",
      "out": "2026-10-15-docs-what-is-in-the-page-costs",
      "viewport": "wide",
      "waitFor": "nav[aria-label='On this page']",
      "measure": ["nav[aria-label='On this page'] a"]
    },
    {
      "path": "/docs/the-runtime/what-the-gate-decides",
      "out": "2026-10-15-docs-what-is-in-the-page-dark",
      "viewport": "wide",
      "waitFor": "nav[aria-label='On this page']",
      "start": { "storage": { "loom-docs-theme": "dark" } },
      "measure": ["nav[aria-label='On this page'] a"]
    },
    {
      "path": "/docs/api-reference",
      "out": "2026-10-15-docs-what-is-in-the-page-reference",
      "viewport": "wide",
      "waitFor": "h1",
      "measure": ["nav[aria-label='On this page']", "article.prose"]
    },
    {
      "path": "/docs/building-with-loom/theming",
      "out": "2026-10-15-docs-what-is-in-the-page-phone",
      "viewport": "phone",
      "waitFor": "h1",
      "measure": ["nav[aria-label='On this page']", "article.prose"]
    }
  ]
}

{
  "outDir": "reports",
  "shots": [
    {
      "out": "2026-10-12-portal-rail-overview-wide",
      "path": "/portal",
      "viewport": "wide",
      "waitFor": "[data-rail=\"screens\"]",
      "measure": ["[data-rail=\"sections\"]", "[data-rail=\"screens\"]", "#page"],
      "before": {
        "path": "/portal/sign-in",
        "do": [
          { "fill": "input[name=key]", "text": "portal-photograph-key-0123456789" },
          { "click": "button[type=submit]" },
          { "waitFor": "text=What Loom has been doing" }
        ]
      }
    },
    {
      "out": "2026-10-12-portal-rail-logs-wide",

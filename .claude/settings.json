{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:21st.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.npmjs.com)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "21st.dev",
        "nextjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org"
      ]
    }
  }
}

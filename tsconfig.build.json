{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * `bundler` resolution is right for source a bundler consumes, but it
     * permits extensionless relative imports that Node's ESM loader refuses.
     * Emitting for Node means resolving the way Node will: every relative
     * specifier already carries `.js`, which is exactly what NodeNext wants and
     * what made this convention correct all along.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  /**
   * `src/testing/**` was excluded until 2026-09-02, when it became a published
   * entry point (0104). Its own `*.test.ts` files are still excluded by the
   * first pattern, so what is emitted is the fixtures and the contract suites
   * and nothing that runs them.
   */
  "exclude": ["src/**/*.test.ts", "src/cli/scaffold-fixture/**"]
}

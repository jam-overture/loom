{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * `bundler` resolution is right for source a bundler consumes, but it
     * permits extensionless relative imports that Node's ESM loader refuses.
     * Emitting for Node means resolving the way Node will: every relative
     * specifier already carries `.js`, which is exactly what NodeNext wants and
     * what made this convention correct all along.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  /**
   * `src/testing/**` was excluded until 2026-09-02, when it became a published
   * entry point (0104). Its own `*.test.ts` files are still excluded by the
   * first pattern, so what is emitted is the fixtures and the contract suites
   * and nothing that runs them.
   *
   * `*.specimen.ts` joins them on 2026-09-12 for the same reason and with the
   * same consequence. `tools/specimen/README.md` tells a lane to put a specimen
   * **beside the code it photographs**, and for every lane whose code is under
   * `src/` that was impossible: a specimen imports `defineSpecimen` from
   * `tools/`, which is outside `rootDir`, so `tsc -p` refuses to emit and
   * `pnpm build` fails — the documented instruction and the build could not
   * both be followed. A specimen is no more part of the published runtime than
   * a test is, so excluding it is the same call rather than a new one. It is
   * still **typechecked**, by `tsconfig.json`, which sets no `rootDir`.
   */
  "exclude": ["src/**/*.test.ts", "src/**/*.specimen.ts", "src/cli/scaffold-fixture/**"]
}
